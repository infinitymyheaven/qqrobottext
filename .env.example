# ==================== NapCat 与群白名单 ====================
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_WS_TOKEN=

# 英文逗号分隔；留空将禁用同步、回复、问候和提醒。
ACTIVE_GROUP_IDS=

# ==================== DeepSeek ====================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_SYSTEM_PROMPT=你是 QQ 群里一名自然、平等、有分寸的群友。你的表达风格、兴趣和交流习惯以系统提供的本地个人背景为参考，但你不是该用户，也不能冒充或透露该用户的身份与资料。不要把任何人称为主人，也不要宣称自己服从群主或某位成员。像真实群友一样结合当前话题简洁发言；尊重所有成员，不编造身份、关系或事实。
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_TOKENS=1024
# 群聊回答使用 Responses API；模型按需调用服务端 web_search。
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT_SECONDS=90
WEB_SEARCH_FAILURE_REPLY=我不知道，暂时没有查到可靠的联网信息。
# 来源只打印到 PowerShell，不加入 QQ 回复。
WEB_SEARCH_LOG_SOURCES=true
WEB_SEARCH_MAX_LOG_SOURCES=5
MAX_REPLY_CHARS=2000

# ==================== 工作时间 ====================
BOT_TIMEZONE=Asia/Shanghai
# HH:MM，开始时间包含、结束时间不包含；00:00 到 24:00 表示全天。
ANSWER_START_TIME=10:00
ANSWER_END_TIME=19:00

# ==================== 消息流回复意愿 ====================
SPONTANEOUS_REPLIES_ENABLED=true
# 每群仅在内存保留最多 500 条、最长 3 小时的群友与机器人消息；每 5 秒刷新环境。
WILLINGNESS_MESSAGE_LIMIT=500
WILLINGNESS_MESSAGE_MAX_AGE_SECONDS=10800
WILLINGNESS_UPDATE_SECONDS=5
# 所有意愿算法回复（包括 @、空 @ 和错误提示）共享每群每日固定上限。
WILLINGNESS_DAILY_REPLY_LIMIT=500
WILLINGNESS_USER_ACTIVITY=0.5
WILLINGNESS_SHORT_WINDOW_SECONDS=600
WILLINGNESS_SHORT_FULL_MESSAGES=30
WILLINGNESS_OLD_FULL_MESSAGES=120

# 话题知识每群按活跃度在 3–10 小时之间分析一次。
WILLINGNESS_TOPIC_ANALYSIS_MIN_HOURS=3
WILLINGNESS_TOPIC_ANALYSIS_MAX_HOURS=10
# ==================== 统一人格（意愿 + 回答内容） ====================
# 只在本机 .env 填写模板账号；示例和仓库中必须保持为空。
PERSONA_USER_ID=
# 旧 WILLINGNESS_PERSONA_USER_ID 仍兼容，但新配置请只使用上面的通用名称。
WILLINGNESS_PERSONAL_BACKGROUND=喜欢轻松、友好的群聊，对计算机、人工智能、游戏、网络文化和日常生活保持好奇。
# 结构化人格仅从当前激活版本生成回答内容因子；群聊风格占 70%。
PERSONA_CONTENT_ENABLED=true
PERSONA_GROUP_STYLE_WEIGHT=0.70
# 白名单群内模板账号新增 50 条发言时更新；不足时满 24 小时且至少 10 条才更新。
PERSONA_INCREMENT_MIN_MESSAGES=50
PERSONA_INCREMENT_MAX_HOURS=24
PERSONA_INCREMENT_FLOOR_MESSAGES=10

# 下面三项只控制常驻机器人从共同群聊进行的首次兼容冷启动。
# 独立人格采集器默认使用最近 90 天、最多 20000 条本人消息，不通过 .env 配置。
WILLINGNESS_HISTORY_DAYS=30
WILLINGNESS_HISTORY_MESSAGE_LIMIT=2000
WILLINGNESS_HISTORY_SCAN_LIMIT=10000

# 双向互动关系向 1 靠近，24 小时后遗忘，并在约 30 天归零。
WILLINGNESS_BOND_INBOUND_RATE=0.12
WILLINGNESS_BOND_OUTBOUND_RATE=0.08
WILLINGNESS_BOND_GRACE_HOURS=24
WILLINGNESS_BOND_ZERO_DAYS=30
# 机器人回复后短期降温；新消息会让意愿更快恢复。
WILLINGNESS_REPLY_COOLDOWN_SECONDS=120

# 所有候选消息（包括 @）经多因素评分和 Sigmoid 转换为回答概率。
# @ 权重很高但仍可能不回答，并且与普通消息共同计入每日 500 条上限。
SPEAK_WEIGHT_USER_ACTIVITY=0.08
SPEAK_WEIGHT_GROUP_ACTIVITY=0.08
SPEAK_WEIGHT_TOPIC_FAMILIARITY=0.12
SPEAK_WEIGHT_SOCIAL_BOND=0.12
SPEAK_WEIGHT_IS_MENTIONED=1.0
SPEAK_WEIGHT_MESSAGE_RELEVANCE=0.12
SPEAK_WEIGHT_FUN_FACTOR=0.08
SPEAK_WEIGHT_RANDOM_NOISE=0.05
SPEAK_SIGMOID_K=6.0
SPEAK_SIGMOID_MIDPOINT=0.65

# ==================== 临时上下文 ====================
# 群聊上下文同时受时间、条数和单条字符数限制。
GROUP_CONTEXT_WINDOW_SECONDS=300
GROUP_CONTEXT_MAX_MESSAGES=20
GROUP_CONTEXT_MESSAGE_MAX_CHARS=300
# 每个群成员分别保存；TTL=0 表示不按闲置时间清空。
CHAT_HISTORY_MESSAGES=10
CHAT_HISTORY_TTL_MINUTES=30
MEMBER_CONTEXT_MATCH_LIMIT=20
FUTURE_CONTEXT_MAX_EVENTS=20

# ==================== 问候和提示文本 ====================
MORNING_GREETING_ENABLED=true
NIGHT_GREETING_ENABLED=true
# 多条随机模板使用两个竖线 || 分隔。
MORNING_GREETING_MESSAGES=早上好，我睡醒啦，今天也来和大家一起聊天。||早呀，我来上班了，今天也请多关照。||大家早上好，我已经醒啦，有事可以叫我。
NIGHT_GREETING_MESSAGES=到休息时间啦，大家晚安，我明天再来。||今天先聊到这里，我要睡觉啦，大家晚安。||晚上好，也晚安啦，我先休息，明天见。
EMPTY_MENTION_REPLY=请在 @ 我后输入想聊的内容。
AI_ERROR_REPLY=抱歉，AI 服务暂时不可用，请稍后再试。

# ==================== 错误现场日志 ====================
# 平时仅在内存保留近期状态；发生 ERROR 时才创建 txt 并写入前后日志。
ERROR_LOG_ENABLED=true
ERROR_LOG_PATH=logs/error_context.txt
ERROR_LOG_BEFORE_RECORDS=30
ERROR_LOG_AFTER_RECORDS=10
# 单个文件最大字节数与旧文件保留数量，避免日志无限增长。
ERROR_LOG_MAX_BYTES=1048576
ERROR_LOG_BACKUP_COUNT=2

# ==================== 成员资料与未来事项 ====================
MEMBER_SYNC_INTERVAL_SECONDS=21600
MEMORY_DB_PATH=data/bot_memory.sqlite3
FUTURE_MEMORY_ENABLED=true
# active_window_all：分析工作时段内全部日期候选消息；participated：只分析机器人参与的消息。
FUTURE_MEMORY_SOURCE=active_window_all
FUTURE_EXTRACTION_CONCURRENCY=2
REMINDER_LEAD_MINUTES=60
REMINDER_FOLLOWUP_MIN_MINUTES=120
REMINDER_FOLLOWUP_MAX_MINUTES=300
