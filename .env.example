# NapCat OneBot v11 正向 WebSocket 服务地址（默认端口 3001，通常无需修改）
NAPCAT_WS_URL=ws://127.0.0.1:3001

# 若在 NapCat WebUI 的 WebSocket 服务器中设置了 Access Token，则在此填写；
# 未设置 Access Token 时请留空。
NAPCAT_WS_TOKEN=

# DeepSeek API Key（必填）。请勿提交真实密钥。
DEEPSEEK_API_KEY=

# DeepSeek 官方 OpenAI 兼容接口；兼容服务商也可改为其 Base URL。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 机器人角色、请求限制与上下文长度。
DEEPSEEK_SYSTEM_PROMPT=你是一个友好、简洁的 QQ 群聊助手。请直接回答用户的问题。
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_TOKENS=1024
CHAT_HISTORY_MESSAGES=10
MAX_REPLY_CHARS=2000

# 必填白名单：仅这些 QQ 群启用同步、回复、问候和提醒；英文逗号分隔。
# 留空是安全默认值：所有新功能均禁用。
ACTIVE_GROUP_IDS=

# 作息与主动回复。回答时段为 [10:00, 19:00)。
BOT_TIMEZONE=Asia/Shanghai
ANSWER_START_HOUR=10
ANSWER_END_HOUR=19
SPONTANEOUS_DAILY_LIMIT=50
SPONTANEOUS_MIN_INTERVAL_SECONDS=600
SPONTANEOUS_SCORE_THRESHOLD=0.65

# 群成员每 6 小时全量刷新；长期记忆只保存在本机数据库。
MEMBER_SYNC_INTERVAL_SECONDS=21600
MEMORY_DB_PATH=data/bot_memory.sqlite3

# 未来事项来源（重要）：
# active_window_all = 分析回答时段内的全部文字消息（默认，API 调用和隐私影响更高）
# participated      = 只分析机器人实际参与回复的消息
FUTURE_MEMORY_SOURCE=active_window_all
REMINDER_LEAD_MINUTES=60
